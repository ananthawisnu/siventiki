# ==============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES UNTUK VERCEL (PROJECT SETTINGS -> ENVIRONMENT VARIABLES)
# ==============================================================================

# 1. Aplikasi Dasar
APP_NAME="KSR PMI Unit INSTIKI"
APP_ENV=production
APP_KEY=base64:kxiIf1qmOHf4xjm1ftD4R3vdrBiaGSFo/Jy+qLbRsro=
APP_DEBUG=false
APP_URL=https://inventaris-ksr-instiki.vercel.app
ASSET_URL=https://inventaris-ksr-instiki.vercel.app

# 2. Database (Gunakan Database Cloud Publik, contoh: TiDB Cloud, Aiven, Railway, Supabase)
# PENTING: localhost / 127.0.0.1 TIDAK BISA diakses dari server serverless Vercel!
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=4000
DB_DATABASE=
DB_USERNAME=your_cloud_db_username
DB_PASSWORD=your_cloud_db_password

# 3. Session & Cache untuk Serverless
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=array

# 4. Storage & Logging Vercel (/tmp filesystem)
LOG_CHANNEL=stderr
VIEW_COMPILED_PATH=/tmp/views
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php
